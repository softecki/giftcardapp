<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Disable clear text traffic globally for security -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    
    <!-- Domain-specific configuration for the API -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">m-malipo.ubx.co.tz</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
